<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>b17e924d-3178-454b-a81b-0a09aa6e1f87</UserSecretsId>
    <!-- The AppHost SDK adds a dashboard package for the restoring machine's own platform,
         so a lock file created on Windows can never match the Linux CI runner. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Security pins over vulnerable transitive versions from Aspire 13.6.0 (no NoWarn).
         MessagePack 2.5.302 via Aspire.Hosting/StreamJsonRpc: GHSA-qhrr-8q5h-9q3h, fixed in 2.5.303.
         System.Security.Cryptography.Pkcs 10.0.12 via Microsoft.Data.SqlClient: GHSA-2fmv-rv2c-59x7,
         GHSA-846f-f764-76mx; 10.0.13 matches Tickets.Infrastructure. Remove once Aspire ships patched deps. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helpdesk.Host\Helpdesk.Host.csproj" />
  </ItemGroup>

</Project>
